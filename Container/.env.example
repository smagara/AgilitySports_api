# Copy this file to .env in the same folder as docker-compose.yml
# and adjust values for your machine.

# Host port published for the API (matches local launchSettings http profile)
HOST_API_PORT=1106

# Image tag created by BuildDockerImage.ps1
API_IMAGE=agilitysports-api:local

ASPNETCORE_ENVIRONMENT=Development

# Must match Database:Mode expected by BaseRepo (Azure | Docker | LocalDb)
DATABASE_MODE=Docker

# Connection from inside the API container to the SQL Server published on the host.
# Default aligns with AgilitySports_Data V2 (BuildDockerImage_V2.ps1) on port 21433.
DOCKER_SQL_CONNECTION=Server=host.docker.internal,21433;Initial Catalog=AgilitySports;User ID=test_user;Password=test.1234;MultipleActiveResultSets=True;Encrypt=True;TrustServerCertificate=True;